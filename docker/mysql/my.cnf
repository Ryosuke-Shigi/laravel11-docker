[mysqld]
# Use utf8mb4 so Laravel can store full Unicode text safely.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
skip-character-set-client-handshake

# Keep DB timestamps aligned with the local learning environment.
default-time-zone = '+09:00'

# Keep binary logs enabled, but expire them after 3 days to avoid mysql-data
# volume growth exhausting the host filesystem.
binlog_expire_logs_seconds = 259200

[client]
default-character-set = utf8mb4

[mysql]
default-character-set = utf8mb4
